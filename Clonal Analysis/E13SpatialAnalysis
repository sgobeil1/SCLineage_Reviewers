def save_tiled_sections_no_references(
    plot_records, output_folder, curr_date, reference_SC=None,
    colour_by="rg", bilateral=True, marker_size=22,
):
    """One panel per clone SECTION, with no reference points/lines/labels.

    `colour_by` is 'rg' or 'identity'. The reference spinal cord outline is
    retained, but the section's reference landmarks are never plotted.
    """
    if colour_by not in {"rg", "identity"}:
        raise ValueError("colour_by must be 'rg' or 'identity'")
    if not plot_records:
        print("No scaled clone sections to plot.")
        return

    x_col = get_scaled_x_column(bilateral=bilateral)
    records = sorted(plot_records, key=lambda r: (r["clone_id"], str(r["section"])))
    n = len(records)
    ncols = min(5, max(1, math.ceil(math.sqrt(n))))
    nrows = math.ceil(n / ncols)
    fig, axes = plt.subplots(
        nrows, ncols, figsize=(4 * ncols, 4 * nrows),
        squeeze=False, constrained_layout=True,
    )

    rg_palette = {"r": ColPals.madmred, "g": ColPals.madmgreen}
    identities_present = set()
    rg_present = set()
    for ax, record in zip(axes.flat, records):
        draw_reference_cord(ax, reference_SC, bilateral=bilateral)
        cells = record["cells"].copy()
        if x_col not in cells.columns:
            raise KeyError(f"Missing {x_col} for {record['clone_id']} / {record['section']}")
        valid = pd.to_numeric(cells[x_col], errors="coerce").notna() & pd.to_numeric(
            cells["Scaled Position Y"], errors="coerce").notna()
        cells = cells.loc[valid]
        identity = cells["Assigned cell identity"].astype("string").str.strip()
        progenitor = identity.eq("Progenitor").fillna(False)

        if colour_by == "rg":
            rg = cells["Colour"].astype("string").str.strip().str.lower()
            colours = rg.map(rg_palette).fillna("lightgrey")
            rg_present.update(rg.dropna().tolist())
            # Match existing R/G figures: progenitors use unfilled circles.
            fill_mask = ~progenitor
            if fill_mask.any():
                ax.scatter(cells.loc[fill_mask, x_col],
                           cells.loc[fill_mask, "Scaled Position Y"],
                           s=marker_size, c=colours.loc[fill_mask],
                           alpha=0.85, edgecolors="none", zorder=3)
            if progenitor.any():
                ax.scatter(cells.loc[progenitor, x_col],
                           cells.loc[progenitor, "Scaled Position Y"],
                           s=marker_size, facecolors="none",
                           edgecolors=colours.loc[progenitor],
                           linewidths=0.8, zorder=4)
        else:
            identities_present.update(identity.dropna().tolist())
            differentiating = identity.eq("Differentiating Neuron").fillna(False)
            regular = ~(progenitor | differentiating)
            if regular.any():
                ax.scatter(cells.loc[regular, x_col],
                           cells.loc[regular, "Scaled Position Y"],
                           s=marker_size,
                           c=cells.loc[regular, "Assigned cell colour"].fillna(
                               e13id.CELL_IDENTITY_PALETTE["Unidentified cells"]),
                           alpha=0.85, edgecolors="none", zorder=3)
            for mask, edge in ((progenitor, "darkgrey"),
                               (differentiating, "#286F9E")):
                if mask.any():
                    ax.scatter(cells.loc[mask, x_col],
                               cells.loc[mask, "Scaled Position Y"],
                               s=marker_size, facecolors="none", edgecolors=edge,
                               linewidths=0.8, zorder=4)

        ax.set_title(f"{record['clone_id']} | Section {record['section']}", fontsize=8)
        ax.tick_params(labelsize=6, length=2)
        ax.set_aspect("equal", adjustable="box")

    for ax in axes.flat[n:]:
        ax.set_visible(False)

    handles = []
    if colour_by == "rg":
        for label, colour in rg_palette.items():
            if label in rg_present:
                handles.append(mpl.lines.Line2D([0], [0], marker="o", linestyle="",
                    markerfacecolor=colour, markeredgecolor="none", markersize=6,
                    label=label))
        if any(r["cells"]["Assigned cell identity"].astype(str).str.strip().eq(
                "Progenitor").any() for r in records):
            handles.append(mpl.lines.Line2D([0], [0], marker="o", linestyle="",
                markerfacecolor="none", markeredgecolor="grey", markersize=6,
                label="Progenitor (open circle)"))
    else:
        for identity in e13id.CELL_IDENTITY_ORDER:
            if identity not in identities_present:
                continue
            if identity == "Progenitor":
                face, edge = "none", "darkgrey"
            elif identity == "Differentiating Neuron":
                face, edge = "none", "#286F9E"
            else:
                face = e13id.CELL_IDENTITY_PALETTE[identity]
                edge = "none"
            handles.append(mpl.lines.Line2D([0], [0], marker="o", linestyle="",
                markerfacecolor=face, markeredgecolor=edge, markersize=6,
                label=identity))

    if handles:
        fig.legend(handles=handles, loc="upper left", bbox_to_anchor=(1.005, 1),
                   frameon=False, fontsize=7)
    side = "bilateral" if bilateral else "hemicord"
    fig.suptitle(f"E13 clones: one panel per section | {side} | {colour_by}",
                 fontsize=12)
    base = output_folder / f"All_clones_tiled_sections_no_refs_{colour_by}_{side}_{curr_date}"
    fig.savefig(base.with_suffix(".svg"), bbox_inches="tight")
    # fig.savefig(base.with_suffix(".png"), dpi=300, bbox_inches="tight")
    plt.close(fig)
    print(f"Saved {base}")

