def retrieve_clone_references(ref_file, animal_id, clone_id):
    """Retrieve every reference row belonging to one animal and clone."""
    return ref_file.loc[
        (ref_file["Animal"] == animal_id)
        & (ref_file["Clone"] == clone_id)
    ].copy()


def retrieve_section_references(clone_refs, section):
    """Retrieve the reference rows belonging to one section of one clone."""
    return clone_refs.loc[clone_refs["Section"] == section].copy()


def references_wide_for_merge(clone_refs):
    """Convert long reference rows to one row per section for merging."""
    if clone_refs.empty:
        return pd.DataFrame(columns=["Section"])

    duplicated = clone_refs.duplicated(subset=["Section", "Ref"], keep=False)
    if duplicated.any():
        duplicate_rows = clone_refs.loc[duplicated, ["Section", "Ref"]]
        raise ValueError(
            "Duplicate reference labels found within section(s):\n"
            + duplicate_rows.to_string(index=False)
        )

    wide = clone_refs.pivot(
        index="Section",
        columns="Ref",
        values=["Position X", "Position Y"],
    )
    wide.columns = [
        f"Ref {ref_label} {coordinate}"
        for coordinate, ref_label in wide.columns
    ]
    return wide.reset_index()

def rotate_section_to_vertical(section_cells, section_refs):
    """
    Rotate one section counterclockwise around CC so that the CC-to-VB
    vector points vertically downward.

    Returns
    -------
    rotated_cells : DataFrame
    rotated_refs : DataFrame
    rotation_degrees : float
        Counterclockwise rotation applied, between 0 and 360 degrees.
    """
    required_refs = {"CC", "VB"}
    available_refs = set(
        section_refs["Ref"].dropna().astype(str).str.strip()
    )

    missing_refs = required_refs - available_refs
    if missing_refs:
        raise ValueError(
            "Cannot rotate section because it is missing reference(s): "
            + ", ".join(sorted(missing_refs))
        )

    cc_row = section_refs.loc[
        section_refs["Ref"].astype(str).str.strip() == "CC"
    ].iloc[0]

    vb_row = section_refs.loc[
        section_refs["Ref"].astype(str).str.strip() == "VB"
    ].iloc[0]

    cc_x = float(cc_row["Position X"])
    cc_y = float(cc_row["Position Y"])
    vb_x = float(vb_row["Position X"])
    vb_y = float(vb_row["Position Y"])

    # Direction of the original CC -> VB vector.
    dx = vb_x - cc_x
    dy = vb_y - cc_y

    if np.isclose(dx, 0) and np.isclose(dy, 0):
        raise ValueError("CC and VB have identical coordinates.")

    current_angle = np.arctan2(dy, dx)

    # A vertically downward vector has angle -90 degrees.
    target_angle = -np.pi / 2

    # Express the required rotation as counterclockwise only: 0 to 2*pi.
    rotation_angle = (target_angle - current_angle) % (2 * np.pi)

    cos_angle = np.cos(rotation_angle)
    sin_angle = np.sin(rotation_angle)

    def rotate_dataframe(df):
        rotated = df.copy()

        translated_x = rotated["Position X"].astype(float) - cc_x
        translated_y = rotated["Position Y"].astype(float) - cc_y

        rotated["Rotated Position X"] = (
            translated_x * cos_angle
            - translated_y * sin_angle
        )
        rotated["Rotated Position Y"] = (
            translated_x * sin_angle
            + translated_y * cos_angle
        )

        return rotated

    rotated_cells = rotate_dataframe(section_cells)
    rotated_refs = rotate_dataframe(section_refs)

    rotation_degrees = np.degrees(rotation_angle)

    rotated_cells["Rotation CCW degrees"] = rotation_degrees
    rotated_refs["Rotation CCW degrees"] = rotation_degrees

    return rotated_cells, rotated_refs, rotation_degrees

def load_reference_SC():
    """Load already-normalized spinal-cord coordinates."""

    outline = pd.read_csv(OUTLINE_PATH)
    ventricle = pd.read_csv(VENTRICLE_PATH)
    vz = pd.read_csv(VZ_PATH)
    fp = pd.read_csv(FP_PATH)
    rp = pd.read_csv(RP_PATH)

    # The first four Outline rows are CC, L, B and T landmarks.
    # They are not sequential vertices of the outline path.
    if "Is path point" in outline.columns:
        outline_path = outline.loc[outline["Is path point"].astype(bool)].copy()
    else:
        outline_path = outline.iloc[4:].copy()

    return {
        "outline": outline_path,
        "ventricle": ventricle,
        "vz": vz,
        "fp": fp,
        "rp": rp
    }
    
def straighten_section_midline(rotated_cells, rotated_refs):
    """
    Shift X coordinates as a function of Y so that VT, CC, and VB lie on
    a perfectly vertical line.
    """
    required_refs = {"VT", "CC", "VB"}
    available_refs = set(
        rotated_refs["Ref"].dropna().astype(str).str.strip()
    )

    missing_refs = required_refs - available_refs
    if missing_refs:
        raise ValueError(
            "Cannot straighten section because it is missing reference(s): "
            + ", ".join(sorted(missing_refs))
        )

    vt_row = rotated_refs.loc[
        rotated_refs["Ref"].astype(str).str.strip() == "VT"
    ].iloc[0]

    cc_row = rotated_refs.loc[
        rotated_refs["Ref"].astype(str).str.strip() == "CC"
    ].iloc[0]

    vb_row = rotated_refs.loc[
        rotated_refs["Ref"].astype(str).str.strip() == "VB"
    ].iloc[0]

    vt_x = float(vt_row["Rotated Position X"])
    vt_y = float(vt_row["Rotated Position Y"])
    cc_x = float(cc_row["Rotated Position X"])
    cc_y = float(cc_row["Rotated Position Y"])
    vb_x = float(vb_row["Rotated Position X"])
    vb_y = float(vb_row["Rotated Position Y"])

    def midline_x(y_values):
        y_values = np.asarray(y_values, dtype=float)
        x_values = np.empty_like(y_values, dtype=float)

        above_cc = y_values >= cc_y
        below_cc = y_values < cc_y

        if np.isclose(vt_y, cc_y):
            x_values[above_cc] = cc_x
        else:
            x_values[above_cc] = cc_x + (
                (y_values[above_cc] - cc_y) * (vt_x - cc_x) / (vt_y - cc_y)
            )

        if np.isclose(vb_y, cc_y):
            x_values[below_cc] = cc_x
        else:
            x_values[below_cc] = cc_x + (
                (y_values[below_cc] - cc_y) * (vb_x - cc_x) / (vb_y - cc_y)
            )

        return x_values

    straightened_cells = rotated_cells.copy()
    straightened_refs = rotated_refs.copy()

    cell_midline_x = midline_x(
        straightened_cells["Rotated Position Y"].astype(float)
    )
    ref_midline_x = midline_x(
        straightened_refs["Rotated Position Y"].astype(float)
    )

    straightened_cells["Straightened Position X"] = (
        straightened_cells["Rotated Position X"].astype(float) - cell_midline_x
    )
    straightened_cells["Straightened Position Y"] = (
        straightened_cells["Rotated Position Y"].astype(float)
    )

    straightened_refs["Straightened Position X"] = (
        straightened_refs["Rotated Position X"].astype(float) - ref_midline_x
    )
    straightened_refs["Straightened Position Y"] = (
        straightened_refs["Rotated Position Y"].astype(float)
    )

    return straightened_cells, straightened_refs


def calculate_reference_template(ref_file):
    """Calculate the median target landmark positions for the reference cord."""
    transformed_reference_sets = []

    for _, section_refs in ref_file.groupby(["Animal", "Clone", "Section"]):
        section_refs = section_refs.copy()
        section_refs["Ref"] = section_refs["Ref"].astype(str).str.strip()

        if section_refs["Ref"].duplicated().any():
            continue

        if not set(EXPECTED_REFS).issubset(set(section_refs["Ref"])):
            continue

        try:
            _, rotated_refs, _ = rotate_section_to_vertical(
                section_cells=section_refs,
                section_refs=section_refs,
            )
            _, straightened_refs = straighten_section_midline(
                rotated_cells=rotated_refs,
                rotated_refs=rotated_refs,
            )
            transformed_reference_sets.append(straightened_refs)
        except ValueError:
            continue

    if not transformed_reference_sets:
        raise ValueError("Could not calculate a reference spinal cord template.")

    all_transformed_refs = pd.concat(
        transformed_reference_sets,
        ignore_index=True,
    )

    reference_template = all_transformed_refs.groupby("Ref")[[
        "Straightened Position X",
        "Straightened Position Y",
    ]].median()

    return reference_template


def scale_section_to_reference(
    straightened_cells,
    straightened_refs,
):
    """
    Scale one straightened section using the same lScale, tScale, and
    bScale calculations as SpotNormScalingRotation.py.
    """
    required_refs = {"L", "T", "CC", "B"}
    available_refs = set(
        straightened_refs["Ref"].dropna().astype(str).str.strip()
    )

    missing_refs = required_refs - available_refs
    if missing_refs:
        raise ValueError(
            "Cannot scale section because it is missing reference(s): "
            + ", ".join(sorted(missing_refs))
        )

    current_refs = straightened_refs.copy()
    current_refs["Ref"] = current_refs["Ref"].astype(str).str.strip()

    cc_x = float(
        current_refs.loc[
            current_refs["Ref"] == "CC",
            "Straightened Position X",
        ].iloc[0]
    )
    cc_y = float(
        current_refs.loc[
            current_refs["Ref"] == "CC",
            "Straightened Position Y",
        ].iloc[0]
    )
    l_x = float(
        current_refs.loc[
            current_refs["Ref"] == "L",
            "Straightened Position X",
        ].iloc[0]
    )
    t_y = float(
        current_refs.loc[
            current_refs["Ref"] == "T",
            "Straightened Position Y",
        ].iloc[0]
    )
    b_y = float(
        current_refs.loc[
            current_refs["Ref"] == "B",
            "Straightened Position Y",
        ].iloc[0]
    )

    if np.isclose(l_x, cc_x):
        raise ValueError("L and CC have the same X coordinate, so lScale cannot be calculated.")
    if np.isclose(t_y, cc_y):
        raise ValueError("T and CC have the same Y coordinate, so tScale cannot be calculated.")
    if np.isclose(b_y, cc_y):
        raise ValueError("B and CC have the same Y coordinate, so bScale cannot be calculated.")

    tScale = dheight / (t_y - cc_y)
    bScale = vheight / (b_y - cc_y)
    lScale = width / abs(l_x - cc_x)

    def scale_dataframe(df, use_hemisphere):
        scaled = df.copy()

        normalized_x = (
            scaled["Straightened Position X"].astype(float) - cc_x
        )
        normalized_y = (
            scaled["Straightened Position Y"].astype(float) - cc_y
        )

        scaled_x_distance = np.abs(normalized_x * lScale)

        scaled["Scaled Position X"] = scaled_x_distance

        if use_hemisphere:
            hemisphere = (
                scaled["Hemisphere"]
                .astype(str)
                .str.strip()
                .str.lower()
            )

            hemisphere_sign = hemisphere.map({
                "l": -1.0,
                "left": -1.0,
                "r": 1.0,
                "right": 1.0,
            })

            scaled["Scaled Position X Bilateral"] = (
                scaled_x_distance * hemisphere_sign
            )

            scaled["Derived hemisphere"] = hemisphere.map({
                "l": "Left",
                "left": "Left",
                "r": "Right",
                "right": "Right",
            })

        else:
            # Reference landmarks are shown on the right hemicord.
            scaled["Scaled Position X Bilateral"] = scaled_x_distance
            scaled["Derived hemisphere"] = pd.NA

        scaled["Scaled Position Y"] = normalized_y.apply(
            lambda y: y * tScale if y > 0 else y * bScale
        )

        scaled["lScale"] = lScale
        scaled["tScale"] = tScale
        scaled["bScale"] = bScale

        return scaled

    scaled_cells = scale_dataframe(
    straightened_cells,
    use_hemisphere=True,
    )

    scaled_refs = scale_dataframe(
        straightened_refs,
        use_hemisphere=False,
    )

    return scaled_cells, scaled_refs


def prepare_clone_output(clone_cells, clone_refs, animal_id, clone_id):
    """Attach section-matched references; do not normalize or scale yet."""
    required_columns = {"Section", "Position X", "Position Y"}
    missing_columns = required_columns - set(clone_cells.columns)
    if missing_columns:
        raise ValueError(
            "Clone file is missing required columns: "
            + ", ".join(sorted(missing_columns))
        )

    cells = clone_cells.copy()
    cells["Section"] = cells["Section"].astype(str).str.strip()

    # Assignment is safer than DataFrame.insert if one of these columns is
    # later added to the source clone spreadsheets.
    cells["Animal"] = animal_id
    cells["Clone"] = clone_id
    cells["Clone ID"] = f"{animal_id}_{clone_id}"

    identity_columns = ["Animal", "Clone", "Clone ID"]
    remaining_columns = [
        column for column in cells.columns if column not in identity_columns
    ]
    cells = cells[identity_columns + remaining_columns]

    refs_wide = references_wide_for_merge(clone_refs)
    prepared = cells.merge(
        refs_wide,
        on="Section",
        how="left",
        validate="many_to_one",
    )

    if "Scaled Position X" in prepared.columns:
        prepared["Normalized Position X"] = prepared["Scaled Position X"]
        prepared["Normalized Position Y"] = prepared["Scaled Position Y"]
    else:
        prepared["Normalized Position X"] = np.nan
        prepared["Normalized Position Y"] = np.nan
    return prepared


def audit_clone_references(clone_cells, clone_refs, animal_id, clone_id, clone_path):
    """Create one reference-matching QC record for a clone."""
    cell_sections = set(
        clone_cells["Section"].dropna().astype(str).str.strip()
    )
    ref_sections = set(
        clone_refs["Section"].dropna().astype(str).str.strip()
    )

    missing_sections = sorted(cell_sections - ref_sections)
    extra_ref_sections = sorted(ref_sections - cell_sections)

    incomplete_sections = []
    for section in sorted(cell_sections & ref_sections):
        section_ref_labels = set(
            retrieve_section_references(clone_refs, section)["Ref"]
            .dropna()
            .astype(str)
            .str.strip()
        )
        missing_labels = sorted(set(EXPECTED_REFS) - section_ref_labels)
        if missing_labels:
            incomplete_sections.append(
                f"{section}: missing {','.join(missing_labels)}"
            )

    return {
        "Clone file": str(clone_path),
        "Animal": animal_id,
        "Clone": clone_id,
        "Clone ID": f"{animal_id}_{clone_id}",
        "Number of cells": len(clone_cells),
        "Cell sections": "; ".join(sorted(cell_sections)),
        "Reference sections": "; ".join(sorted(ref_sections)),
        "Missing reference sections": "; ".join(missing_sections),
        "Reference-only sections": "; ".join(extra_ref_sections),
        "Incomplete reference sets": "; ".join(incomplete_sections),
        "Exact section match": not missing_sections,
    }


