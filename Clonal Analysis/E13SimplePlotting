### Cell identity in minority vs majority fragments of bilateral clones
# Minority / majority are defined using the TOTAL number of cells (including
# progenitors) on the left and right sides of EACH bilateral clone.
# Composition itself is drawn from the no-progenitor clone table, matching
# the other E13 identity composition plots. Equal-size fragments are excluded
# because neither hemisphere can be called the minority.

fragment_sizes = rg_clones_e13_bi_df[
    ['Clone', 'Total cells_l', 'Total cells_r']
].copy()
fragment_sizes['Total cells_l'] = pd.to_numeric(
    fragment_sizes['Total cells_l'], errors='coerce'
)
fragment_sizes['Total cells_r'] = pd.to_numeric(
    fragment_sizes['Total cells_r'], errors='coerce'
)

# Avoid inventing a minority for ties or for missing/zero hemisphere counts.
valid_fragments = (
    fragment_sizes['Total cells_l'].gt(0)
    & fragment_sizes['Total cells_r'].gt(0)
    & fragment_sizes['Total cells_l'].ne(fragment_sizes['Total cells_r'])
)
excluded_fragment_sizes = fragment_sizes.loc[~valid_fragments].copy()
fragment_sizes = fragment_sizes.loc[valid_fragments].copy()
fragment_sizes['Minority hemisphere'] = np.where(
    fragment_sizes['Total cells_l'] < fragment_sizes['Total cells_r'],
    'l', 'r'
)
fragment_sizes['Majority hemisphere'] = np.where(
    fragment_sizes['Total cells_l'] > fragment_sizes['Total cells_r'],
    'l', 'r'
)

identity_by_fragment_df = rg_clones_e13_no_pr_bi_df.merge(
    fragment_sizes[
        ['Clone', 'Total cells_l', 'Total cells_r',
         'Minority hemisphere', 'Majority hemisphere']
    ][['Clone', 'Minority hemisphere', 'Majority hemisphere']],
    on='Clone', how='inner', validate='one_to_one'
)

# Use the same labels, order, and colours as the existing E13 identity plots.
fragment_identity_order = [
    identity for identity in e13id.CELL_IDENTITY_ORDER_NO_PR
    if identity + '_l' in identity_by_fragment_df.columns
    and identity + '_r' in identity_by_fragment_df.columns
]
fragment_identity_palette = e13id.CELL_IDENTITY_PALETTE_NO_PR
fragment_records = []
for _, clone_row in identity_by_fragment_df.iterrows():
    for side_type, side_col in [
        ('Minority', clone_row['Minority hemisphere']),
        ('Majority', clone_row['Majority hemisphere'])
    ]:
        for identity in fragment_identity_order:
            count = pd.to_numeric(
                clone_row[identity + '_' + side_col], errors='coerce'
            )
            fragment_records.append({
                'Clone': clone_row['Clone'],
                'Animal': clone_row['Animal'],
                'TM': clone_row['TM'],
                'Fragment': side_type,
                'Hemisphere': 'Left' if side_col == 'l' else 'Right',
                'Marker': identity,
                'Count': 0 if pd.isna(count) else float(count)
            })

fragment_identity_details_df = pd.DataFrame(fragment_records)
fragment_summary_cols = ['Fragment', 'Marker', 'Count', 'Total', 'Proportion']
fragment_identity_summary_df = pd.DataFrame(columns=fragment_summary_cols)

if not fragment_identity_details_df.empty:
    fragment_identity_summary_df = (
        fragment_identity_details_df
        .groupby(['Fragment', 'Marker'], as_index=False, observed=True)['Count']
        .sum()
    )
    fragment_identity_summary_df['Total'] = (
        fragment_identity_summary_df.groupby('Fragment')['Count'].transform('sum')
    )
    fragment_plot_df = fragment_identity_summary_df[
        fragment_identity_summary_df['Marker'] != 'Unidentified cells'
    ].copy()

    fragment_plot_df['Total'] = (
        fragment_plot_df.groupby('Fragment')['Count'].transform('sum')
    )

    fragment_plot_df['Proportion'] = np.where(
        fragment_plot_df['Total'] > 0,
        fragment_plot_df['Count'] / fragment_plot_df['Total'],
        0.0
    )

fragment_output_path = (
    bilat_hemi_output_path + '/Bi_marker_composition_minority_vs_majority_' + curr_date
)

fragment_identity_summary_df = fragment_identity_summary_df[fragment_identity_summary_df['Marker'] != 'Unidentified cells'].copy()

if not fragment_plot_df.empty and fragment_plot_df['Count'].sum() > 0:
    # Same plotting function, identity palette, and order as the other E13 plots.
    # Each bar pools cell counts across clones (not average clone proportions).
    fragment_order = ['Majority', 'Minority']
    cap.snsStackedBarPlot(
        data=fragment_plot_df,
        x='Fragment',
        hue='Marker',
        weights='Proportion',
        x_axis_title='Bilateral clone fragment',
        y_axis_title='Proportion of cells',
        x_axis_ticks=fragment_order,
        output_path=fragment_output_path,
        palette=fragment_identity_palette,
        fig_size=(2, 4.5),
        hue_order=fragment_identity_order,
    )
else:
    print('No eligible bilateral clone fragments for minority/majority composition plot.')

with pd.ExcelWriter(fragment_output_path + '.xlsx', engine='xlsxwriter') as writer:
    fragment_identity_details_df.to_excel(writer, sheet_name='Clone identity counts', index=False)
    fragment_identity_summary_df.to_excel(writer, sheet_name='Pooled proportions', index=False)
    fragment_sizes.to_excel(writer, sheet_name='Fragment assignments', index=False)
    excluded_fragment_sizes.to_excel(writer, sheet_name='Excluded ties or missing', index=False)

print('Minority/majority fragment composition:',
      len(fragment_sizes), 'bilateral clones included,',
      len(excluded_fragment_sizes), 'excluded (ties or missing sides).')
