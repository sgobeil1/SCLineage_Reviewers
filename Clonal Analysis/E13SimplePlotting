# Add a column with clone_id by merging entries in 'Litter', 'animal', and 'clone id'
# and separating them by an underscore and adding a c before the clone id
# in the format S166_a2_c1. Also duplicate it into 'Clone' so the helper
# functions from ClonalAnalysisSimplePlotting work without modification.
def format_clone_component(value):
    """Format clone IDs read from CSV/Excel so 1.0 becomes 1 and blanks stay blank."""
    if pd.isna(value):
        return ''
    text = str(value).strip()
    if text.endswith('.0'):
        text = text[:-2]
    return text

def make_clone_id(row):
    litter = format_clone_component(row['Litter'])
    animal = format_clone_component(row['animal'])
    clone_id = format_clone_component(row['clone id'])
    return f"{litter}_{animal}_c{clone_id}"

