def main():
    curr_date = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")

    output_folder = OUTPUT_ROOT / f"{curr_date}_E13spatialanalysis"
    clone_output_folder = output_folder / "Individual clone normalization inputs"
    output_folder.mkdir(parents=True, exist_ok=False)
    clone_output_folder.mkdir(parents=True, exist_ok=False)

    input_file = caf.read_csv(str(INPUT_FILE_PATH), skip_rows=0)
    ref_file = caf.read_csv(str(REF_FILE_PATH), skip_rows=0)
    audit_rows = []
    error_rows = []
    raw_plot_records = []
    rotated_plot_records = []
    straightened_plot_records = []
    scaled_plot_records = []

    # SC level look-up
    clone_overview = caf.read_csv(
        str(CLONE_OVERVIEW_PATH),
        skip_rows=0
    )

    # Build clone IDs in the same form used in this spatial script
    clone_overview["clone_id"] = (
        clone_overview["Litter"].astype(str).str.strip()
        + "_"
        + clone_overview["animal"].astype(str).str.strip()
        + "_c"
        + clone_overview["clone id"].astype(str)
            .str.replace(r"\.0$", "", regex=True)
            .str.strip()
    )

    # Clean RC level
    clone_overview["RC Level"] = (
        clone_overview["RC Level"]
        .astype("string")
        .str.strip()
    )

    # One RC level per clone
    rc_level_lookup = (
        clone_overview
        .dropna(subset=["RC Level"])
        .drop_duplicates(subset="clone_id")
        .set_index("clone_id")["RC Level"]
        .to_dict()
    )

    reference_SC = load_reference_SC()
    
    for row_index, input_row in input_file.iterrows():
        # The supplied InputFile marks excluded clones in this column.
        if pd.notna(input_row["Excluded"]):
            print(
                f"Skipping excluded clone at input row {row_index}: "
                f"{input_row['Litter']}_{input_row['Animal']}_c{int(input_row['Clone'])} "
                f"({input_row['Reason']})"
            )
            continue

        if pd.isna(input_row["Spreadsheet"]):
            print(f"Skipping input row {row_index}: no spreadsheet path.")
            continue

        clone_path = Path(str(input_row["Spreadsheet"]).strip().strip("'\""))
        animal_id = f"{input_row['Litter']}_{input_row['Animal']}"
        clone_id = f"c{int(input_row['Clone'])}"
        full_clone_id = f"{animal_id}_{clone_id}"

        try:
            print(
                f"\nLoading clone {row_index + 1}/{len(input_file)}: "
                f"{full_clone_id}\n{clone_path}"
            )
            clone_cells = caf.read_csv(str(clone_path), skip_rows=0)
            clone_cells.columns = clone_cells.columns.astype(str).str.strip()
            clone_cells = e13id.add_cell_identity_annotations(clone_cells)

            # As in ClonalAnalysis.py: retrieve the clone first, then use
            # Section for the exact section-level matches.
            clone_refs = retrieve_clone_references(
                ref_file=ref_file,
                animal_id=animal_id,
                clone_id=clone_id,
            )

            audit = audit_clone_references(
                clone_cells=clone_cells,
                clone_refs=clone_refs,
                animal_id=animal_id,
                clone_id=clone_id,
                clone_path=clone_path,
            )
            audit_rows.append(audit)

            if clone_refs.empty:
                print(f"WARNING: no Clone_Ref rows found for {full_clone_id}")
            if audit["Missing reference sections"]:
                print(
                    f"WARNING: {full_clone_id} has no exact reference match for "
                    f"section(s): {audit['Missing reference sections']}"
                )

            clone_cells_for_plot = clone_cells.copy()
            clone_cells_for_plot["Section"] = (
                clone_cells_for_plot["Section"].astype(str).str.strip()
            )
            clone_refs_for_plot = clone_refs.copy()
            if not clone_refs_for_plot.empty:
                clone_refs_for_plot["Section"] = (
                    clone_refs_for_plot["Section"].astype(str).str.strip()
                )

            transformed_clone_sections = []

            for section in sorted(clone_cells_for_plot["Section"].dropna().unique()):
                section_cells = clone_cells_for_plot.loc[
                    clone_cells_for_plot["Section"] == section
                ].copy()
                
                section_refs = retrieve_section_references(
                    clone_refs_for_plot, section
                )
                
                raw_section_cells = section_cells.copy()
                raw_section_refs = section_refs.copy()

                try:
                    rotated_section_cells, rotated_section_refs, rotation_degrees = (
                        rotate_section_to_vertical(
                            section_cells=section_cells,
                            section_refs=section_refs,
                        )
                    )

                    straightened_section_cells, straightened_section_refs = (
                        straighten_section_midline(
                            rotated_cells=rotated_section_cells,
                            rotated_refs=rotated_section_refs,
                        )
                    )

                    scaled_section_cells, scaled_section_refs = (
                        scale_section_to_reference(
                            straightened_cells=straightened_section_cells,
                            straightened_refs=straightened_section_refs,
                        )
                    )

                except ValueError as exc:
                    print(
                        f"WARNING: could not completely transform "
                        f"{full_clone_id} | {section}: {exc}"
                    )

                    rotated_section_cells = section_cells.copy()
                    rotated_section_cells["Rotated Position X"] = (
                        rotated_section_cells["Position X"]
                    )
                    rotated_section_cells["Rotated Position Y"] = (
                        rotated_section_cells["Position Y"]
                    )

                    rotated_section_refs = section_refs.copy()
                    if not rotated_section_refs.empty:
                        rotated_section_refs["Rotated Position X"] = (
                            rotated_section_refs["Position X"]
                        )
                        rotated_section_refs["Rotated Position Y"] = (
                            rotated_section_refs["Position Y"]
                        )

                    straightened_section_cells = rotated_section_cells.copy()
                    straightened_section_cells["Straightened Position X"] = (
                        straightened_section_cells["Rotated Position X"]
                    )
                    straightened_section_cells["Straightened Position Y"] = (
                        straightened_section_cells["Rotated Position Y"]
                    )

                    straightened_section_refs = rotated_section_refs.copy()
                    if not straightened_section_refs.empty:
                        straightened_section_refs["Straightened Position X"] = (
                            straightened_section_refs["Rotated Position X"]
                        )
                        straightened_section_refs["Straightened Position Y"] = (
                            straightened_section_refs["Rotated Position Y"]
                        )

                    scaled_section_cells = straightened_section_cells.copy()
                    scaled_section_cells["Scaled Position X"] = (
                        scaled_section_cells["Straightened Position X"]
                    )
                    scaled_section_cells["Scaled Position Y"] = (
                        scaled_section_cells["Straightened Position Y"]
                    )

                    scaled_section_refs = straightened_section_refs.copy()
                    if not scaled_section_refs.empty:
                        scaled_section_refs["Scaled Position X"] = (
                            scaled_section_refs["Straightened Position X"]
                        )
                        scaled_section_refs["Scaled Position Y"] = (
                            scaled_section_refs["Straightened Position Y"]
                        )

                missing_ref_labels = []
                if section_refs.empty:
                    missing_ref_labels = EXPECTED_REFS.copy()
                else:
                    section_ref_labels = set(
                        section_refs["Ref"].dropna().astype(str).str.strip()
                    )
                    missing_ref_labels = sorted(
                        set(EXPECTED_REFS) - section_ref_labels
                    )

                record_info = {
                    "clone_id": full_clone_id,
                    "section": section,
                    "RC Level": rc_level_lookup.get(full_clone_id, pd.NA),
                    "missing_sections": [section] if section_refs.empty else [],
                    "missing_ref_labels": missing_ref_labels,
                }
                raw_plot_records.append(
                    {
                        **record_info,
                        "cells": raw_section_cells,
                        "refs": raw_section_refs,
                    }
                )
                rotated_plot_records.append(
                    {
                        **record_info,
                        "cells": rotated_section_cells,
                        "refs": rotated_section_refs,
                    }
                )
                straightened_plot_records.append(
