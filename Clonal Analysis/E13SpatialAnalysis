        base_path.with_suffix(".svg"),
        bbox_inches="tight",
    )

    fig.savefig(
        base_path.with_suffix(".png"),
        dpi=300,
        bbox_inches="tight",
    )

    plt.close(fig)

    print(
        "\nSaved progenitor clone-coloured overlay:"
        f"\n{base_path}"
    )

def save_progenitor_identity_overlay_figure(
    plot_records,
    output_folder,
    curr_date,
    reference_SC=None,
    marker_radius=10,
    marker_alpha=0.8,
    include_unidentified=False,
    bilateral=False,
):
    """
    Plot only progenitor cells from all clones.

    Each progenitor is coloured according to the non-progenitor identities
    found elsewhere in the same clone.

    If a clone contains multiple non-progenitor identities, each progenitor
    is drawn as a circle divided into equal coloured sectors.
    """
    if not plot_records:
        print(
            "No clone sections were successfully loaded; "
            "no progenitor identity overlay was created."
        )
        return

    fig, ax = plt.subplots(
        figsize=(8, 8),
        constrained_layout=True,
    )

    draw_reference_cord(ax, reference_SC)

    clone_ids = sorted({
        record["clone_id"]
        for record in plot_records
    })

    plotted_identities = set()
    clones_without_non_progenitor_identity = []
    
    # Collapse all unidentified positional subclasses into one display identity.
    unidentified_identity_map = {
        "Unidentified dorsal": "Unidentified cells",
        "Unidentified ventral": "Unidentified cells",
    }

    # Identities that should not determine progenitor colour.
    excluded_from_progenitor_identity = {
        "Progenitor",
        "Differentiating Neuron",
    }

    # Plot/legend order after combining the unidentified categories. 
    identity_order_for_progenitor_plot = [
        identity
        for identity in e13id.CELL_IDENTITY_ORDER_NO_PR
        if identity not in {
            "Differentiating Neuron",
            "Unidentified dorsal",
            "Unidentified ventral",
        }
    ]

    for clone_id in clone_ids:
        clone_records = [
            record
            for record in plot_records
            if record["clone_id"] == clone_id
        ]

        # Combine every section belonging to this clone.
        clone_cells = pd.concat(
            [
                record["cells"]
                for record in clone_records
            ],
            ignore_index=True,
        )

        if "Assigned cell identity" not in clone_cells.columns:
            print(
                f"WARNING: {clone_id} has no "
                "'Assigned cell identity' column."
            )
            continue

        # Only the progenitor coordinates will be drawn.
        progenitor_cells = clone_cells[
            clone_cells["Assigned cell identity"] == "Progenitor"
        ].copy()

        if progenitor_cells.empty:
            continue

        # Clean and combine identities before determining the colours assigned
        # to progenitors from this clone.
        plot_identity = (
            clone_cells["Assigned cell identity"]
            .astype("string")
            .str.strip()
            .replace(unidentified_identity_map)
        )

        # Exclude progenitors themselves and differentiating neurons.
        eligible_identity = ~plot_identity.isin(
            excluded_from_progenitor_identity
        )

        identity_counts = (
            plot_identity.loc[eligible_identity]
            .dropna()
            .value_counts()
        )

        # Optionally remove the single combined unidentified category.
        if not include_unidentified:
            identity_counts = identity_counts.drop(
                labels=["Unidentified cells"],
                errors="ignore",
            )

        # Preserve the standard E13 identity order, while using only the
        # combined unidentified category.
        clone_identities = [
            identity
            for identity in identity_order_for_progenitor_plot
            if identity in identity_counts.index
        ]

        clone_colours = [
            e13id.CELL_IDENTITY_PALETTE[identity]
            for identity in clone_identities
        ]

        plotted_identities.update(clone_identities)

        if len(clone_identities) == 0:
            clones_without_non_progenitor_identity.append(clone_id)

        # Every progenitor belonging to this clone gets the same
        # clone-level identity colour combination.
        for _, progenitor in progenitor_cells.iterrows():
            draw_multicolour_circle(
                ax=ax,
                x=float(progenitor["Scaled Position X"]),
                y=float(progenitor["Scaled Position Y"]),
                colours=clone_colours,
                radius=marker_radius,
                edgecolor="black",
                alpha=1.0,
                linewidth=0.4,
                zorder=3,
            )

    # Only show identities that actually occurred in the plot.
    identity_handles = [
        mpl.lines.Line2D(
            [0],
            [0],
            marker="o",
            linestyle="",
            markerfacecolor=e13id.CELL_IDENTITY_PALETTE[identity],
            markeredgecolor="black",
            markeredgewidth=0.4,
            markersize=7,
            alpha=marker_alpha,
            label=identity,
        )
        for identity in identity_order_for_progenitor_plot
        if identity in plotted_identities
    ]

    if clones_without_non_progenitor_identity:
        identity_handles.append(
            mpl.lines.Line2D(
                [0],
                [0],
                marker="o",
                linestyle="",
                markerfacecolor="lightgrey",
                markeredgecolor="black",
                markeredgewidth=0.4,
                markersize=7,
                label="No identified non-progenitor cells",
            )
        )

    ax.set_title(
        "Progenitor positions\n"
        "colours indicate non-progenitor identities in the same clone",
        fontsize=12,
    )

    ax.set_aspect("equal", adjustable="box")
    ax.tick_params(labelsize=8, length=3)

    if identity_handles:
        ax.legend(
            handles=identity_handles,
            loc="upper left",
            bbox_to_anchor=(1.02, 1),
            frameon=False,
            fontsize=7,
        )

    base_path = (
        output_folder
        / f"All_clones_progenitors_by_clone_identity_{curr_date}"
    )

    fig.savefig(
        base_path.with_suffix(".svg"),
        bbox_inches="tight",
    )

    fig.savefig(
        base_path.with_suffix(".png"),
        dpi=300,
        bbox_inches="tight",
    )

    plt.close(fig)

    print(
        "\nSaved progenitor identity overlay:"
        f"\n{base_path}"
    )

    if clones_without_non_progenitor_identity:
        print(
            "\nClones with progenitors but no identified "
            "non-progenitor identities:"
        )

        for clone_id in clones_without_non_progenitor_identity:
            print("  ", clone_id)

def draw_reference_cord(
    ax,
    reference_SC,
    bilateral=False,
):
    """Draw the normalized reference spinal cord."""

    if reference_SC is None:
        return

    outline = reference_SC["outline"]
    ventricle = reference_SC["ventricle"]
    vz = reference_SC["vz"]
    fp = reference_SC["fp"]
    rp = reference_SC["rp"]

    def draw_side(x_sign):
        outline_x = (
            outline["Normalized X"].astype(float)
            * x_sign
        )

        ventricle_x = (
            ventricle["Normalized X"].astype(float)
            * x_sign
        )

        vz_x = (
            vz["Normalized X"].astype(float)
            * x_sign
        )
        
        fp_x = (
            fp["Normalized X"].astype(float)
            * x_sign
        )
        
        rp_x = (
                    rp["Normalized X"].astype(float)
                    * x_sign
                )

        ax.fill(
            outline_x,
            outline["Normalized Y"],
            facecolor="#f2f2f2",
            edgecolor="#808080",
            linewidth=1.2,
            alpha=1.0,
            zorder=0,
        )

        ax.plot(
            ventricle_x,
            ventricle["Normalized Y"],
            color="#606060",
            linewidth=1.0,
            zorder=1,
        )

        ax.plot(
            vz_x,
            vz["Normalized Y"],
            color="#808080",
            linewidth=1.0,
            linestyle="--",
            zorder=1,
        )
        
        ax.plot(
            fp_x,
            fp["Normalized Y"],
            color="#808080",
            linewidth=1.0,
            linestyle="--",
            zorder=1,
        )
        
        ax.plot(
            rp_x,
            rp["Normalized Y"],
            color="#808080",
            linewidth=1.0,
            linestyle="--",
            zorder=1,
        )

    # Positive-X hemicord, matching Scaled Position X.
    draw_side(x_sign=1)

    if bilateral:
        draw_side(x_sign=-1)

    if bilateral:
        ax.set_xlim(-676, 676)
    else:
        ax.set_xlim(-26, 676)

    ax.set_ylim(-486, 486)
    ax.set_aspect("equal", adjustable="box")

def get_scaled_x_column(bilateral=False):
    if bilateral:
        return "Scaled Position X Bilateral"

    return "Scaled Position X"

