            clone_dict['OL count' + suffix] = int(((glial_vals == 'ol') & hemi_pos).sum())
            clone_dict['PR count' + suffix] = int(((glial_vals == 'pr') & hemi_pos).sum())

            clone_dict['Astrocyte count (PA,FA,GL)' + suffix] = (
                clone_dict['PA count' + suffix] +
                clone_dict['FA count' + suffix] +
                clone_dict['GL count' + suffix]
            )

            clone_dict['Glia count (PA,FA,WF,GL,OG,OL)' + suffix] = (
                clone_dict['PA count' + suffix] +
                clone_dict['FA count' + suffix] +
                clone_dict['WF count' + suffix] +
                clone_dict['GL count' + suffix] +
                clone_dict['OG count' + suffix] +
                clone_dict['OL count' + suffix]
            )

            clone_dict['Progenitor count' + suffix] = clone_dict['PR count' + suffix]
            clone_dict['Uncertain count' + suffix] = int((uncertain_pos & hemi_pos).sum())

            # D/V to dI4/5 category per hemisphere
            hemi_clone_cells = clone_cells[hemi_pos].copy()
            hemi_marker_pos_df = marker_pos_df[hemi_pos].copy()

            if hemi_clone_cells.shape[0] == 0:
                clone_dict['D/V to dI4/5 category' + suffix] = np.nan

            else:
                if 'D/V to DI4/5 border' in hemi_clone_cells.columns:
                    hemi_dv_border_vals = (
                        hemi_clone_cells['D/V to DI4/5 border']
                        .fillna('')
                        .astype(str)
                        .str.strip()
                        .str.lower()
                    )

                    hemi_has_d = hemi_dv_border_vals.isin(['d', 'dorsal']).any()
                    hemi_has_v = hemi_dv_border_vals.isin(['v', 'ventral']).any()
                    hemi_has_dv_border = hemi_has_d and hemi_has_v

                else:
                    hemi_has_dv_border = False

                hemi_has_dorsal_di4_di5 = False

                if 'Lmx1b' in hemi_marker_pos_df.columns:
                    hemi_has_dorsal_di4_di5 = hemi_has_dorsal_di4_di5 or hemi_marker_pos_df['Lmx1b'].any()

                if 'Tlx3' in hemi_marker_pos_df.columns:
                    hemi_has_dorsal_di4_di5 = hemi_has_dorsal_di4_di5 or hemi_marker_pos_df['Tlx3'].any()

                if 'Lbx1' in hemi_marker_pos_df.columns:
                    hemi_has_dorsal_di4_di5 = hemi_has_dorsal_di4_di5 or hemi_marker_pos_df['Lbx1'].any()

