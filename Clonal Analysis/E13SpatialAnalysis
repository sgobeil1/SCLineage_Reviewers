                    }
                )
                scaled_plot_records.append(
                    {
                        **record_info,
                        "cells": scaled_section_cells,
                        "refs": scaled_section_refs,
                    }
                )

                transformed_clone_sections.append(scaled_section_cells)

            transformed_clone_cells = pd.concat(
                transformed_clone_sections,
                ignore_index=True,
            )
            prepared = prepare_clone_output(
                clone_cells=transformed_clone_cells,
                clone_refs=clone_refs,
                animal_id=animal_id,
                clone_id=clone_id,
            )
            output_csv = (
                clone_output_folder / f"{full_clone_id}_normalized.csv"
            )
            prepared.to_csv(output_csv, index=False)

