def save_tiled_clone_overlay_rg_figure(
    plot_records,
    output_folder,
    output_name,
    curr_date,
    reference_SC=None,
    bilateral=False,
):
    """
    Save one panel per clone, with all sections overlaid.

    Non-progenitor cells:
        Colour == 'r' -> red
        Colour == 'g' -> green

    Progenitors:
        empty circles regardless of Colour.

    bilateral=False:
        Plot all cells on the positive-X hemicord.

    bilateral=True:
        Retain signed left/right positions.
    """

    if not plot_records:
        print(
            "No clone sections were successfully loaded; "
            "no r/g clone-overlay plot was created."
        )
        return

    x_column = get_scaled_x_column(bilateral=bilateral)

    clone_ids = sorted({
        record["clone_id"]
        for record in plot_records
    })

    n_plots = len(clone_ids)
    n_cols = min(5, max(1, math.ceil(math.sqrt(n_plots))))
    n_rows = math.ceil(n_plots / n_cols)

    fig, axes = plt.subplots(
        n_rows,
        n_cols,
        figsize=(4.0 * n_cols, 4.0 * n_rows),
        squeeze=False,
        constrained_layout=True,
    )

    colour_map = {
        "r": ColPals.madmred,
        "g": ColPals.madmgreen,
    }

    for ax, clone_id in zip(axes.flat, clone_ids):

        draw_reference_cord(
            ax=ax,
            reference_SC=reference_SC,
            bilateral=bilateral,
        )

        clone_records = [
            record
            for record in plot_records
            if record["clone_id"] == clone_id
        ]

        for record in clone_records:

            cells = record["cells"]

            if x_column not in cells.columns:
                raise KeyError(
                    f"{x_column!r} is missing from cells for "
                    f"{clone_id}, section {record['section']}."
                )

            if "Colour" not in cells.columns:
                raise KeyError(
                    f"'Colour' column is missing from "
                    f"{clone_id}, section {record['section']}."
                )

            # Identify progenitors.
            is_progenitor = (
                cells["Assigned cell identity"]
                .astype(str)
                .str.strip()
                .eq("Progenitor")
            )

            non_progenitor_cells = cells.loc[~is_progenitor].copy()
            progenitor_cells = cells.loc[is_progenitor].copy()

            # Colour cells according to r/g in Colour column
            if not non_progenitor_cells.empty:

