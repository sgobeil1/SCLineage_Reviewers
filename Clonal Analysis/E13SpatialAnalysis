def save_bilateral_all_clones_overlay(
    plot_records, output_folder, curr_date, reference_SC=None,
    colour_by="clone", marker_size=22, marker_alpha=0.85,
):
    """All sections and clones on one bilateral cord; colour by clone or RC level."""
    if not plot_records:
        print("No scaled records available for bilateral overlay.")
        return
    if colour_by not in {"clone", "rc_level"}:
        raise ValueError("colour_by must be 'clone' or 'rc_level'")

    # Preserve one colour per clone across all its sections.
    clone_records = {}
    for record in plot_records:
        clone_records.setdefault(record["clone_id"], []).append(record)
    clone_ids = sorted(clone_records)

    if colour_by == "clone":
        # Use the tab20 palette for the bilateral all-clones-by-clone overlay.
        # If there are more than 20 clones, the palette cycles.
        tab20_colours = list(plt.get_cmap("tab20").colors)
        clone_colours = {
            clone_id: tab20_colours[i % len(tab20_colours)]
            for i, clone_id in enumerate(clone_ids)
        }
    else:
        # Four distinguishable colour families; each clone has a different shade.
        level_cmaps = {
            "Ce": "Blues", "Th": "Oranges", "Lu": "Greens", "Sa": "Purples"
        }
        clone_colours = {}
        for level, cmap_name in level_cmaps.items():
            level_clones = [
                cid for cid in clone_ids
                if str(clone_records[cid][0].get("RC Level", "")).strip().lower()
                == level.lower()
            ]
            cmap = plt.get_cmap(cmap_name)
            for i, cid in enumerate(level_clones):
                # Avoid nearly-white shades that disappear on a white background.
                shade = 0.42 + 0.50 * (i + 0.5) / max(len(level_clones), 1)
                clone_colours[cid] = cmap(shade)
        for cid in clone_ids:
            if cid not in clone_colours:
                clone_colours[cid] = "#777777"  # missing/unrecognized RC level

    fig, ax = plt.subplots(figsize=(9, 8), constrained_layout=True)
    draw_reference_cord(ax, reference_SC, bilateral=True)
    legend_handles = []
    for clone_id in clone_ids:
        cells = pd.concat(
            [r["cells"] for r in clone_records[clone_id]], ignore_index=True
        )
        x_col = get_scaled_x_column(bilateral=True)
        if x_col not in cells.columns:
            print(f"WARNING: skipping {clone_id}; missing {x_col}")
            continue
        xy = cells[[x_col, "Scaled Position Y"]].apply(
            pd.to_numeric, errors="coerce"
        ).dropna()
        if xy.empty:
            continue
        colour = clone_colours[clone_id]
        ax.scatter(
            xy[x_col], xy["Scaled Position Y"], s=marker_size,
            color=colour, alpha=marker_alpha, linewidths=0, zorder=3,
        )
        level = str(clone_records[clone_id][0].get("RC Level", "Unknown"))
        legend_handles.append(mpl.lines.Line2D(
            [0], [0], marker="o", linestyle="", markersize=6,
            markerfacecolor=colour, markeredgecolor="none",
            label=f"{level} | {clone_id}" if colour_by == "rc_level" else clone_id,
        ))

    ax.set_title(
        "All clones superimposed — bilateral\n"
        + ("coloured by clone" if colour_by == "clone"
           else "coloured by rostrocaudal level (individual clone shades)"),
        fontsize=12,
    )
    ax.set_aspect("equal", adjustable="box")
    ax.tick_params(labelsize=8, length=3)
    if legend_handles:
        ax.legend(handles=legend_handles, loc="upper left",
                  bbox_to_anchor=(1.02, 1), frameon=False, fontsize=7,
                  ncol=1 if len(legend_handles) < 45 else 2)
    base_path = output_folder / f"All_clones_bilateral_by_{colour_by}_{curr_date}"
    fig.savefig(base_path.with_suffix(".svg"), bbox_inches="tight")
    fig.savefig(base_path.with_suffix(".png"), dpi=300, bbox_inches="tight")
    plt.close(fig)
    print(f"Saved bilateral {colour_by} overlay: {base_path}")


