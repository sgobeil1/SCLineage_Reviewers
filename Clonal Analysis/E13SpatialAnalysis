def draw_multicolour_circle(
    ax,
    x,
    y,
    colours,
    radius=10,
    edgecolor="black",
    alpha = 0.8,
    linewidth=0.4,
    zorder=3,
):
    """
    Draw one circular marker divided into equal coloured sectors.

    Parameters
    ----------
    ax : matplotlib axis
    x, y : float
        Marker centre in plot/data coordinates.
    colours : list
        Colours representing identities present in the clone.
    radius : float
        Circle radius in scaled spinal-cord coordinate units.
    """
    colours = list(colours)

    if len(colours) == 0:
        colours = ["lightgrey"]

    if len(colours) == 1:
        circle = Wedge(
            center=(x, y),
            r=radius,
            theta1=0,
            theta2=360,
            alpha = alpha,
            facecolor=colours[0],
            edgecolor=edgecolor,
            linewidth=linewidth,
            zorder=zorder,
        )
        ax.add_patch(circle)
        return

    sector_size = 360.0 / len(colours)

    for sector_index, colour in enumerate(colours):
        theta1 = 90 + sector_index * sector_size
        theta2 = 90 + (sector_index + 1) * sector_size

        sector = Wedge(
            center=(x, y),
            r=radius,
            theta1=theta1,
            theta2=theta2,
            alpha = alpha,
            facecolor=colour,
            edgecolor=edgecolor,
            linewidth=linewidth,
            zorder=zorder,
        )

        ax.add_patch(sector)
        
def plot_clone_panel(
    ax,
    clone_cells,
    clone_refs,
    title,
    x_column,
    y_column,
    cell_colour = 'k',
    ref_colour = 'b',
    reference_SC=None,
    bilateral=False
):
    
    draw_reference_cord(ax, reference_SC)

    ax.scatter(
        clone_cells[x_column],
        clone_cells[y_column],
        s=10,
        c=cell_colour,
        alpha=0.75,
        linewidths=0,
        label="Cells",
    )

    if not clone_refs.empty:
        ax.scatter(
            clone_refs[x_column],
            clone_refs[y_column],
            s=20,
            c=ref_colour,
            alpha=0.9,
            linewidths=0,
            label="References",
        )
    
        # Draw a line connecting VT -> CC -> VB
        line_order = ["VT", "CC", "VB"]
        line_points = []

        for ref_label in line_order:
            ref_row = clone_refs.loc[
                clone_refs["Ref"].astype(str).str.strip() == ref_label
            ]

            if not ref_row.empty:
                line_points.append(
                    (
                        ref_row.iloc[0][x_column],
                        ref_row.iloc[0][y_column],
                    )
                )

        # Only draw the line if VT, CC, and VB are all present
        if len(line_points) == 3:
            ax.plot(
                [point[0] for point in line_points],
                [point[1] for point in line_points],
                color="blue",
                linewidth=1,
                alpha=0.8,
            )

        for _, ref_row in clone_refs.iterrows():
            ax.annotate(
                f"{ref_row['Section']}:{ref_row['Ref']}",
                (ref_row[x_column], ref_row[y_column]),
                xytext=(2, 2),
                textcoords="offset points",
                fontsize=5,
                color="blue",
            )

    ax.set_title(title, fontsize=8)
    ax.set_aspect("equal", adjustable="datalim")
    ax.tick_params(labelsize=6, length=2)


def save_tiled_clone_figure(
    plot_records,
    output_folder,
    curr_date,
    x_column,
    y_column,
    stage_name,
    stage_title,
    cell_colour_column=None,
    reference_SC=None,
    bilateral=False
):
    """Save one tiled QC figure containing one panel per clone section."""
    if not plot_records:
        print("No clone sections were successfully loaded; no tiled plot was created.")
        return

    n_plots = len(plot_records)
    n_cols = min(5, max(1, math.ceil(math.sqrt(n_plots))))
    n_rows = math.ceil(n_plots / n_cols)

    fig, axes = plt.subplots(
        n_rows,
        n_cols,
        figsize=(4.0 * n_cols, 4.0 * n_rows),
        squeeze=False,
        constrained_layout=True,
    )
        
    for ax, record in zip(axes.flat, plot_records):
        status = ""
        if record["missing_sections"]:
            status = "\nmissing refs: " + ", ".join(record["missing_sections"])

        if cell_colour_column is None:
            cell_colours = "k"
        else:
            cell_colours = (
                record["cells"][cell_colour_column]
                .fillna(e13id.CELL_IDENTITY_PALETTE["Unidentified cells"])
            )

        plot_clone_panel(
            ax,
            record["cells"],
            record["refs"],
