def save_progenitor_clone_overlay_figure(
    plot_records,
    output_folder,
    curr_date,
    reference_SC=None,
    marker_size=15,
    marker_alpha=0.8,
    bilateral=False,
):
    """
    Plot only progenitor cells from all clones.

    Progenitors are coloured according to clone identity.

    Parameters
    ----------
    plot_records : list
        Scaled plot records.

    output_folder : Path
        Output folder.

    curr_date : str
        Date/time string used in output filename.

    reference_SC : dict, optional
        Reference spinal cord outline.

    marker_size : float
        Marker size passed to ax.scatter().

    marker_alpha : float
        Marker opacity from 0 (transparent) to 1 (opaque).

    bilateral : bool
        False = plot all cells on the positive-X hemicord.
        True = retain left/right hemisphere positions.
    """

    if not plot_records:
        print(
            "No clone sections were successfully loaded; "
            "no progenitor clone-coloured overlay was created."
        )
        return

    fig, ax = plt.subplots(
        figsize=(8, 8),
        constrained_layout=True,
    )

    draw_reference_cord(
        ax=ax,
        reference_SC=reference_SC,
        bilateral=bilateral,
    )

    x_column = get_scaled_x_column(bilateral=bilateral)

    clone_ids = sorted({
        record["clone_id"]
        for record in plot_records
    })

    # Use a smaller set of high-contrast colours, combined with shapes
    base_colours = list(plt.get_cmap("tab10").colors)

    marker_cycle = [
        "o",  # circle
        "s",  # square
        "^",  # triangle up
        "v",  # triangle down
        "X",  # filled x
        "<",  # triangle left
        ">",  # triangle right
    ]

    style_combinations = [
        {"color": color, "marker": marker}
        for marker in marker_cycle
        for color in base_colours
    ]

    if len(clone_ids) > len(style_combinations):
        raise ValueError(
            f"Not enough clone styles for {len(clone_ids)} clones. "
            f"Increase the number of colours or marker shapes."
        )

    clone_styles = {
        clone_id: style_combinations[i]
        for i, clone_id in enumerate(clone_ids)
    }
    clones_with_progenitors = []

    for clone_id in clone_ids:

        clone_records = [
            record
            for record in plot_records
            if record["clone_id"] == clone_id
        ]

        # Combine all sections belonging to this clone
        clone_cells = pd.concat(
            [
                record["cells"]
                for record in clone_records
            ],
            ignore_index=True,
        )

        if "Assigned cell identity" not in clone_cells.columns:
            print(
                f"WARNING: {clone_id} has no "
                "'Assigned cell identity' column."
            )
            continue

        # Keep only progenitors
        progenitor_cells = clone_cells[
            clone_cells["Assigned cell identity"] == "Progenitor"
        ].copy()

        if progenitor_cells.empty:
            continue

        clones_with_progenitors.append(clone_id)

        style = clone_styles[clone_id]

        ax.scatter(
            progenitor_cells[x_column],
            progenitor_cells["Scaled Position Y"],
            s=marker_size,
            marker=style["marker"],
            facecolors=style["color"],
            edgecolors="black",
            linewidths=0.4,
            alpha=marker_alpha,
            zorder=3,
        )

    # Legend only for clones that actually contain progenitors
    handles = [
        mpl.lines.Line2D(
            [0],
            [0],
            marker=clone_styles[clone_id]["marker"],
            linestyle="",
            markerfacecolor=clone_styles[clone_id]["color"],
            markeredgecolor="black",
            markeredgewidth=0.4,
            markersize=7,
            alpha=marker_alpha,
            label=clone_id,
        )
        for clone_id in clones_with_progenitors
    ]

    ax.set_title(
        "Progenitor positions\n"
        "coloured by clone",
        fontsize=12,
    )

    ax.set_aspect(
        "equal",
        adjustable="box",
    )

    ax.tick_params(
        labelsize=8,
        length=3,
    )

    if handles:
        ax.legend(
            handles=handles,
            loc="upper left",
            bbox_to_anchor=(1.02, 1),
            frameon=False,
            fontsize=7,
        )

    plot_type = "bilateral" if bilateral else "right hemicord"

    base_path = (
        output_folder
        / f"All_clones_progenitors_by_clone_{plot_type}_{curr_date}"
