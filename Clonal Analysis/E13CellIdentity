def marker_positive(value):
    """Return True for entries containing yes or maybe."""
    if pd.isna(value):
        return False

    value = str(value).strip().lower()
    return "yes" in value or "maybe" in value


def get_positive_markers(row):
    """Return all configured positive markers for one cell."""
    return [
        marker
        for marker in CELL_IDENTITY_MARKERS
        if marker_positive(row.get(marker, np.nan))
    ]


def assign_cell_identity(row):
    """
    Assign exactly one identity.

    Specific identities take precedence over Lbx1.
    Lhx5/Pax2 and Lbx1 are assigned only when exclusive.
    Rules are in order of precedence.
    """
    # Progenitor takes highest precedence
    if str(row.get("Glial cell", "")).strip().lower() == "pr":
        return "Progenitor"

    # Differentiating neuron takes precedence over molecular identity.
    if marker_positive(row.get("Differentiating Neuron", np.nan)):
        return "Differentiating Neuron"

    positive = set(get_positive_markers(row))

    positive = set(get_positive_markers(row))

    identity_rules = [
        ("dI5 (Lmx1b+ and/or Tlx3+)", "Lmx1b" in positive or 'Tlx3' in positive),
        ("dI1 (Barhl1+)", "Barhl1" in positive),
        (
            "dI2 (FoxD3+En1-)",
            "FoxD3" in positive and "En1" not in positive,
        ),
        ("dI3 (dorsal Isl1/2+)", "Isl" in positive),
        ("dI6 (Dmrt3+)", "Dmrt3" in positive),
        ("V0 (Evx1+)", "Evx1" in positive),
        ("V1 (En1+)", "En1" in positive),
        ("V2a (Chx10+)", "Chx10" in positive),
        ("V2b (Gata3+)", "Gata3" in positive),
        ("V3 (Nkx2.2+)", "Nkx2.2" in positive),
        ("dI4 (Sall3+)", "Sall3" in positive),
        (
            "Inhibitory INs (only Lhx5/Pax2+)",
            positive == {"Lhx5/Pax2"},
        ),
        (
            "dI4/5/6 (only Lbx1+)",
            positive == {"Lbx1"},
        ),
    ]

    for identity, matches in identity_rules:
        if matches:
            return identity

    # If no molecular identity was assigned, use position relative
    # to the dI4/5 border to classify unidentified cells.
    dv_border = (
        str(row.get("D/V to DI4/5 border", ""))
        .strip()
        .lower()
    )

    if dv_border in {"d", "dorsal"}:
        return "Unidentified dorsal"

    if dv_border in {"v", "ventral"}:
        return "Unidentified ventral"

    return "Unidentified cells"


def add_cell_identity_annotations(df):
    """Add positive markers, assigned identity, and assigned colour."""
    annotated = df.copy()

    positive_marker_lists = annotated.apply(
        get_positive_markers,
        axis=1,
    )

    annotated["Positive markers"] = positive_marker_lists.apply(
        lambda markers: "; ".join(markers)
    )

    annotated["Assigned cell identity"] = annotated.apply(
        assign_cell_identity,
        axis=1,
    )

    annotated["Assigned cell colour"] = (
        annotated["Assigned cell identity"]
        .map(CELL_IDENTITY_PALETTE)
    )

    return annotated


def add_identity_counts(
    clone_dict,
    clone_cells,
    left_pos=None,
    right_pos=None,
):
    """
    Add identity counts to a clone summary using the assigned identity column.

    This guarantees that clone composition tables use the same mutually
    exclusive assignments as the exported cell-level table.
    """
    assigned = clone_cells["Assigned cell identity"]

    for identity in CELL_IDENTITY_ORDER:
        identity_pos = assigned == identity
        clone_dict[identity] = int(identity_pos.sum())

        if left_pos is not None:
            clone_dict[identity + "_l"] = int(
                (identity_pos & left_pos).sum()
            )

        if right_pos is not None:
            clone_dict[identity + "_r"] = int(
                (identity_pos & right_pos).sum()
            )

    return clone_dict
