                        )

                        hemi_has_dorsal_di4_di5 = hemi_has_dorsal_di4_di5 or hemi_sall3_non_pr_pos.any()

                    else:
                        hemi_has_dorsal_di4_di5 = hemi_has_dorsal_di4_di5 or hemi_marker_pos_df['Sall3'].any()

                if hemi_has_dv_border:
